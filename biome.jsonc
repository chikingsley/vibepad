{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!apps/client/assets",
      "!apps/client/src/components/ui",
      "!apps/client/src/global.css",
      "!packages/provider-codex/generated"
    ]
  },
  "linter": {
    "domains": {
      "reactNative": "all"
    },
    "rules": {
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            // These components render their children inside <Text>.
            "skip": ["OnboardingHeading", "OptionLabel"]
          }
        }
      },
      "style": {
        "useThisInClassMethods": {
          "level": "error",
          "options": {
            // An `implements` contract requires instance methods, used or not.
            "ignoreClassesWithImplements": "all"
          }
        }
      }
    }
  }
}
