{
  "name": "@vibepad/host",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "bun src/bootstrap-cli.ts",
    "dev": "bun --watch src/index.ts",
    "release": "bun ../../scripts/build-host-release.ts",
    "service": "bun src/service-cli.ts",
    "start": "bun src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chikingsley/peacockery-voice-client": "workspace:*",
    "@vibepad/protocol": "workspace:*",
    "@vibepad/provider-agy": "workspace:*",
    "@vibepad/provider-claude-code": "workspace:*",
    "@vibepad/provider-codex": "workspace:*",
    "@vibepad/provider-opencode": "workspace:*",
    "bonjour": "^3.5.1",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.19.5",
    "@types/bonjour": "^3.5.13",
    "@types/bun": "1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
