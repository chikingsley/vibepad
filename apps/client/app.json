{
  "expo": {
    "name": "VibePad",
    "slug": "vibepad",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vibepad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "XM69J99HWP",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "studio.peacockery.vibepad",
      "infoPlist": {
        "NSBonjourServices": ["_vibepad._tcp."],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "VibePad connects to your paired development hosts over your private network."
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "package": "studio.peacockery.vibepad",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#020307",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "react-native-nano-icons",
        {
          "iconSets": [
            {
              "fontFamily": "VibePadUI",
              "inputDir": "./assets/icons/ui",
              "outputDir": "./assets/icons/nanoicons"
            },
            {
              "fontFamily": "VibePadProviders",
              "inputDir": "./assets/icons/providers",
              "outputDir": "./assets/icons/nanoicons"
            }
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020307",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false,
          "microphonePermission": "Allow VibePad to turn your speech into an editable message."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
