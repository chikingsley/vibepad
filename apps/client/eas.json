{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 21.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "VIBEPAD_APP_ATTEST_ENVIRONMENT": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "VIBEPAD_APP_ATTEST_ENVIRONMENT": "development"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "VIBEPAD_APP_ATTEST_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "testflight": {}
  }
}
