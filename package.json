{
  "name": "vibepad",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter @vibepad/client start",
    "dev:host": "bun run --filter @vibepad/host dev",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  }
}
