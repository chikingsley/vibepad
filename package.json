{
  "name": "vibepad",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:native && bun run check:host-release && bun run lint && bun run typecheck && bun run test",
    "check:host-release": "bun run scripts/check-host-release-inputs.ts",
    "check:native": "bun run scripts/check-native-modules.ts",
    "dev": "bun run --filter @vibepad/client start",
    "dev:host": "bun run --filter @vibepad/host dev",
    "fix": "ultracite fix",
    "host:bootstrap": "bun run --filter @vibepad/host bootstrap",
    "host:release": "bun run scripts/build-host-release.ts",
    "host:service": "bun run --filter @vibepad/host service",
    "lint": "ultracite check",
    "test": "bun run --filter '*' test",
    "test:live:claude-code": "VIBEPAD_LIVE_CLAUDE_CODE_TESTS=1 bun run --filter @vibepad/provider-claude-code test",
    "test:live:codex": "bun run --filter @vibepad/provider-codex test:live",
    "test:live:opencode": "bun run --filter @vibepad/provider-opencode test:live",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "react-native-enriched-markdown"
  ]
}
